# 默认配置样例。仅含连接信息，不含任何真实凭据；业务参数不在此配置
# （结算窗口时长由 settle_config 表按 数据域/终端类型 管理，默认 900 秒）。
IOT_PG_DSN=postgres://USER:PASSWORD@127.0.0.1:5432/iot?sslmode=disable
IOT_LISTEN=127.0.0.1:8080
IOT_MQTT_URL=tcp://127.0.0.1:1883
IOT_MQTT_CLIENT_ID=iot-admin
# 网关的接入凭证由 Broker 管理（本实现为 BroMQ），平台只透传：
IOT_MQTT_USERNAME=
IOT_MQTT_PASSWORD=

# Broker 管理接口（网关注册/注销）。留空则只写本地注册表，不同步 Broker。
# 平台只通过该 HTTP 接口与 Broker 通讯，不直接改 Broker 的库或配置。
IOT_BROKER_ADMIN_URL=http://192.168.100.1:8080
IOT_BROKER_USERNAME=
IOT_BROKER_PASSWORD=
